# Auto detect text files and perform LF normalization
* text=auto

# Source code and scripts
*.go text eol=lf
*.mod text eol=lf
*.sum text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.iss text eol=crlf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Binaries
*.ico binary
*.exe binary
*.dll binary
*.zip binary
